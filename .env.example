# Required by compose.yaml. Use a long, randomly generated value.
DMA_API_KEY=replace-with-a-long-random-secret

# Optional: identifies this self-hosted deployment's tenant scope.
DMA_TENANT_ID=self-hosted

# Optional hardening/retention knobs (defaults shown).
# DMA_MAX_METADATA_BYTES=16384
# DMA_MAX_METADATA_DEPTH=10
# DMA_IDEMPOTENCY_RETENTION_DAYS=30
# DMA_MAX_REQUEST_BYTES=1048576
